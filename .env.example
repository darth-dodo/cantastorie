# Cantastorie environment configuration
# Copy to .env and fill in values. The .env file is gitignored.
#
# The web service runs story generation in-process, so the deployed app needs
# OPENROUTER_API_KEY, the R2_* values and the Clerk keys too (docs/setup.md).
# No key ever reaches the browser or is needed at story time.

# OpenRouter — story writing, safety judges, images, and narration.
OPENROUTER_API_KEY=

# LangSmith — observability/tracing for the pipeline and FastAPI app.
# When LANGSMITH_TRACING is false (or unset), the langsmith package is inert.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cantastorie
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Sentry — error monitoring for the FastAPI app and the pipeline (ADR-009).
# Unset SENTRY_DSN means Sentry never initializes. Server-side only; errors only.
# SENTRY_RELEASE defaults to Render's RENDER_GIT_COMMIT when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Application log level for src.* (stdout, key=value lines). Default INFO.
LOG_LEVEL=INFO

# Cloudflare R2 — published stories (public bucket) + staged runs (pending).
# Setting R2_ENDPOINT_URL requires the other R2_* values; publish refuses
# incomplete config. R2_PENDING_BUCKET must name a separate private bucket
# whenever R2_ENDPOINT_URL is set; it never falls back to R2_BUCKET.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
R2_PENDING_BUCKET=

# Clerk auth (AI-409/AI-426, ADR-003/ADR-005). Unset means /workshop and /parent
# answer 404 — those areas do not exist. Both require CLERK_PUBLISHABLE_KEY and CLERK_JWKS_URL.
# CLERK_JWKS_URL is typically https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=  # Clerk Frontend API base URL (iss claim); unset ⇒ issuer not enforced

# Paths and limits (defaults from src/config.py; uncomment to override).
# ASSET_BASE: where the player fetches published stories. Default is the bundled
# dev fixtures; production uses the R2 public URL + /published, no trailing slash.
# ASSET_BASE=/static/content
# CONTENT_DIR: the pipeline's artifact cache (one folder per story).
# CONTENT_DIR=content
# STAGING_DIR: where a generated story is staged for review before publish.
# STAGING_DIR=staging
# PARENT_DAILY_RUN_CAP: story runs a family may start per UTC day (operators exempt).
# PARENT_DAILY_RUN_CAP=3
# GLOBAL_DAILY_RUN_CAP: story runs per UTC day across every family and the
# operator. Families are refused past it; the operator is alerted at 80% and
# at the cap (docs/setup.md, Spend ceilings).
# GLOBAL_DAILY_RUN_CAP=40
